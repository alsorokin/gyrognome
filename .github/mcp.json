{
  "mcpServers": {
    "playwright": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--block-service-workers",
        "--caps",
        "devtools"
      ],
      "tools": [
        "*"
      ]
    }
  }
}
