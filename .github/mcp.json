{
  "mcpServers": {
    "playwright": {
      "type": "local",
      "command": "node",
      "env": {
        "npm_config_allow_remote": "all"
      },
      "args": [
        ".github/playwright-mcp.cjs",
        "--headless",
        "--isolated",
        "--block-service-workers",
        "--caps",
        "devtools"
      ],
      "tools": [
        "*"
      ]
    }
  }
}
